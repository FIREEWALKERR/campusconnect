# Copy to .env and enter your own values. No real credentials are supplied.
DB_URL=jdbc:mysql://localhost:3306/campusconnect?connectionTimeZone=UTC
DB_USERNAME=campusconnect
DB_PASSWORD=
# Used only by the optional Docker database:
DB_ROOT_PASSWORD=
# First installation: create only your administrator, no sample records.
SPRING_PROFILES_ACTIVE=bootstrap
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Optional sample import: choose profile dev instead and set this password.
DEMO_PASSWORD=
APP_TIME_ZONE=Asia/Kolkata
CURRENCY_CODE=INR
PLACEMENT_CONTACT_EMAIL=
RESUME_DIRECTORY=./data/resumes
RESUME_MAX_SIZE=5MB
REQUEST_MAX_SIZE=6MB
SESSION_TIMEOUT=30m
SALARY_BUCKETS=4
COOKIE_SECURE=false
SERVER_PORT=8080
DB_NAME=campusconnect
DB_PORT=3306
